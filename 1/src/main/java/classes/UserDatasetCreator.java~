package classes;

import java.io.FileWriter;
import java.io.IOException;
import org.json.JSONObject;

public class UserDatasetCreator {

    public void writeUserInfoToJSON(int userId) {
        String directoryPath = "datasets";
        String filePath = directoryPath + "/user_" + userId + "_dataset.csv";

        JSONObject userInfo = new JSONObject();
        userInfo.put("userId", userId);
        userInfo.put("datasetPath", filePath);

        try (FileWriter file = new FileWriter("current_user_info.json")) {
            file.write(userInfo.toString());
            file.flush();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
