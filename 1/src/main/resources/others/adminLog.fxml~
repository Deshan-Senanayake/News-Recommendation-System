<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="743.0" prefWidth="668.0" stylesheets="@../css/login-style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.s.AdminLogin">
   <children>
      <VBox alignment="CENTER" prefHeight="100.0" styleClass="top-section" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label styleClass="title-label" text="Login" textFill="white" />
         </children>
      </VBox>
      <HBox alignment="CENTER" prefHeight="500.0" spacing="30.0" styleClass="center-section" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="120.0">
         <children>
            <VBox alignment="CENTER" spacing="15.0" styleClass="admin-login-section">
               <children>
                  <Label styleClass="section-title" text="Administrator Login" />
                  <TextField promptText="Admin Name" styleClass="input-field" />
                  <PasswordField promptText="Password" styleClass="input-field" />
                  <Button styleClass="login-button" text="Confirm Login" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" spacing="20.0" styleClass="bottom-section" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Button styleClass="bottom-button" text="Back" />
            <Button styleClass="bottom-button" text="Home" />
         </children>
      </HBox>
   </children>
</AnchorPane>
